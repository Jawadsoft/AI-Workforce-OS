generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                   @id @default(cuid())
  name                  String
  slug                  String                   @unique
  industry              Industry?
  plan                  String                   @default("free")
  isActive              Boolean                  @default(true)
  settings              Json                     @default("{}")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
  isApproved            Boolean                  @default(false)
  tickets               ActivityTicket[]
  agents                Agent[]
  escalationRules       AgentEscalationRule[]
  agentMemoryFacts      AgentMemoryFact[]
  approvals             Approval[]
  auditLogs             AuditLog[]
  crmConnections        CRMConnection[]
  commLogs              CommunicationLog[]
  connectedAccounts     ConnectedAccount[]
  conversations         Conversation[]
  conversationSummaries ConversationSummary[]
  documentTemplates     DocumentTemplate[]
  emailAgentRules       EmailAgentRule[]
  emailConversations    EmailConversation[]
  documents             GeneratedDocument[]
  knowledgeDocs         KnowledgeDocument[]
  messageChunks         MessageChunk[]
  processedEmails       ProcessedEmail[]
  socialAccounts        SocialAccount[]
  socialInteractions    SocialInteraction[]
  socialPosts           SocialPost[]
  stormReports          StormReport[]
  assignedAdmins        SuperAdminTenantAccess[]
  tasks                 Task[]
  featureFlags          TenantFeatureFlag[]
  hierarchy             TenantHierarchy?
  users                 User[]
  webhooks              Webhook[]
}

model User {
  id               String                   @id @default(cuid())
  tenantId         String
  email            String                   @unique
  name             String
  password         String
  role             UserRole                 @default(USER)
  avatar           String?
  isActive         Boolean                  @default(true)
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  createdByAdminId String?
  maxTenants       Int?                     @default(5)
  permissions      String[]                 @default([])
  department       String?
  designation      String?
  managerId        String?
  nodePosition     Json?
  phone            String?
  supervisedAgents Agent[]                  @relation("AgentSupervisor")
  escalationRules  AgentEscalationRule[]    @relation("EscalationTarget")
  approvals        Approval[]               @relation("ApprovalReviewer")
  messages         Message[]
  resetTokens      PasswordResetToken[]
  ssoTokens        SsoToken[]
  managedTenants   SuperAdminTenantAccess[] @relation("AdminTenantAssignments")
  tasks            Task[]                   @relation("TaskAssignee")
  createdByAdmin   User?                    @relation("SubAdminCreator", fields: [createdByAdminId], references: [id])
  createdSubAdmins User[]                   @relation("SubAdminCreator")
  manager          User?                    @relation("OrgHierarchy", fields: [managerId], references: [id])
  directReports    User[]                   @relation("OrgHierarchy")
  tenant           Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model SuperAdminTenantAccess {
  id          String   @id @default(cuid())
  adminUserId String
  tenantId    String
  assignedAt  DateTime @default(now())
  assignedBy  String?
  admin       User     @relation("AdminTenantAssignments", fields: [adminUserId], references: [id], onDelete: Cascade)
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([adminUserId, tenantId])
  @@index([adminUserId])
  @@index([tenantId])
}

model Agent {
  id                    String                @id @default(cuid())
  tenantId              String
  name                  String
  role                  String
  industry              Industry
  avatar                String?
  prompt                String
  status                AgentStatus           @default(ACTIVE)
  permissions           String[]
  tools                 String[]
  approvalRules         Json                  @default("{}")
  isTemplate            Boolean               @default(false)
  templateId            String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  voiceId               String?
  hierarchyPosition     Json?
  supervisorUserId      String?
  assignedTickets       ActivityTicket[]      @relation("TicketAssignee")
  createdTickets        ActivityTicket[]      @relation("TicketCreator")
  supervisor            User?                 @relation("AgentSupervisor", fields: [supervisorUserId], references: [id])
  tenant                Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  crmAccess             AgentCRMAccess[]
  escalationRules       AgentEscalationRule[] @relation("AgentEscalations")
  knowledgeDocs         AgentKnowledge[]
  memoryFacts           AgentMemoryFact[]
  approvals             Approval[]
  connectedAccounts     ConnectedAccount[]
  conversations         Conversation[]
  conversationSummaries ConversationSummary[]
  emailRules            EmailAgentRule[]
  messageChunks         MessageChunk[]
  tasks                 Task[]
}

model TenantHierarchy {
  id        String   @id @default(cuid())
  tenantId  String   @unique
  layout    Json     @default("{}")
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AgentEscalationRule {
  id            String   @id @default(cuid())
  tenantId      String
  agentId       String
  trigger       String
  triggerLabel  String
  action        String   @default("notify")
  targetUserId  String?
  targetAgentId String?
  urgency       String   @default("NORMAL")
  createdAt     DateTime @default(now())
  agent         Agent    @relation("AgentEscalations", fields: [agentId], references: [id], onDelete: Cascade)
  targetUser    User?    @relation("EscalationTarget", fields: [targetUserId], references: [id])
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([tenantId])
}

model AgentTemplate {
  id            String     @id @default(cuid())
  name          String
  role          String
  industries    Industry[]
  description   String
  defaultPrompt String
  tools         String[]
  isPublic      Boolean    @default(true)
  createdAt     DateTime   @default(now())
  avatar        String?
}

model HelpArticleOverride {
  id          String   @id @default(cuid())
  articleId   String   @unique
  title       String?
  category    String?
  audience    String?
  summary     String?
  steps       Json?
  tips        Json?
  isCustom    Boolean  @default(false)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model HelpArticleImage {
  id        String   @id @default(cuid())
  articleId String
  url       String
  caption   String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([articleId])
}

model Conversation {
  id             String                @id @default(cuid())
  tenantId       String
  agentId        String
  userId         String?
  title          String?
  metadata       Json                  @default("{}")
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  channel        String                @default("INTERNAL")
  status         String                @default("OPEN")
  callerEmail    String?
  callerPhone    String?
  isPrimary      Boolean               @default(false)
  runningSummary String?
  tickets        ActivityTicket[]
  agent          Agent                 @relation(fields: [agentId], references: [id])
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  summaries      ConversationSummary[]
  messages       Message[]
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  userId         String?
  role           MessageRole
  content        String
  metadata       Json         @default("{}")
  createdAt      DateTime     @default(now())
  agentId        String?
  briefingType   String?
  attachments    Json         @default("[]")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User?        @relation(fields: [userId], references: [id])
}

model Task {
  id               String       @id @default(cuid())
  tenantId         String
  agentId          String?
  assigneeId       String?
  title            String
  description      String?
  intent           String       @default("general_task")
  status           TaskStatus   @default(PENDING)
  result           Json?
  requiresApproval Boolean      @default(false)
  metadata         Json         @default("{}")
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  dueDate          DateTime?
  priority         TaskPriority @default(MEDIUM)
  crmProvider      String?
  crmTaskId        String?
  pushedToCRM      Boolean      @default(false)
  pushedToCRMAt    DateTime?
  approval         Approval?
  agent            Agent?       @relation(fields: [agentId], references: [id])
  assignee         User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  tenant           Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Approval {
  id              String         @id @default(cuid())
  tenantId        String
  taskId          String?        @unique
  status          ApprovalStatus @default(PENDING)
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  agentId         String?
  approverId      String?
  description     String?
  payload         Json?
  rejectionReason String?
  resolvedAt      DateTime?
  title           String?
  type            String         @default("general")
  agent           Agent?         @relation(fields: [agentId], references: [id])
  approver        User?          @relation("ApprovalReviewer", fields: [approverId], references: [id])
  task            Task?          @relation(fields: [taskId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model KnowledgeDocument {
  id        String           @id @default(cuid())
  tenantId  String
  name      String
  fileType  String
  fileUrl   String
  fileSize  Int
  status    String           @default("processing")
  createdAt DateTime         @default(now())
  agents    AgentKnowledge[]
  chunks    KnowledgeChunk[]
  tenant    Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model KnowledgeChunk {
  id         String            @id @default(cuid())
  documentId String
  content    String
  embedding  Json?
  metadata   Json              @default("{}")
  chunkIndex Int
  createdAt  DateTime          @default(now())
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
}

model AgentKnowledge {
  agentId    String
  documentId String
  agent      Agent             @relation(fields: [agentId], references: [id], onDelete: Cascade)
  document   KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@id([agentId, documentId])
}

model IndustryKnowledgePack {
  id          String                 @id @default(cuid())
  industry    String                 @unique
  name        String
  description String?
  isActive    Boolean                @default(true)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt
  documents   IndustryKnowledgeDoc[]
}

model IndustryKnowledgeDoc {
  id         String                   @id @default(cuid())
  packId     String
  name       String
  category   String
  agentRoles String[]
  content    String
  isActive   Boolean                  @default(true)
  createdAt  DateTime                 @default(now())
  chunks     IndustryKnowledgeChunk[]
  pack       IndustryKnowledgePack    @relation(fields: [packId], references: [id], onDelete: Cascade)
}

model IndustryKnowledgeChunk {
  id         String               @id @default(cuid())
  docId      String
  content    String
  embedding  Json?
  chunkIndex Int
  createdAt  DateTime             @default(now())
  doc        IndustryKnowledgeDoc @relation(fields: [docId], references: [id], onDelete: Cascade)
}

model GeneratedDocument {
  id        String   @id @default(cuid())
  tenantId  String
  agentId   String?
  title     String
  type      String
  format    String   @default("PDF")
  fileUrl   String?
  content   Json?
  status    String   @default("generating")
  createdAt DateTime @default(now())
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model DocumentTemplate {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  type        String
  description String?
  htmlBody    String
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model CRMConnection {
  id          String           @id @default(cuid())
  tenantId    String
  provider    CRMProvider
  name        String
  baseUrl     String?
  apiKey      String?
  config      Json             @default("{}")
  isActive    Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  agentAccess AgentCRMAccess[]
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model AgentCRMAccess {
  agentId      String
  connectionId String
  permissions  String[]
  agent        Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  connection   CRMConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@id([agentId, connectionId])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CommunicationLog {
  id             String        @id @default(cuid())
  tenantId       String
  channel        CommChannel
  direction      CommDirection
  from           String
  to             String
  body           String?
  status         String        @default("sent")
  twilioSid      String?
  durationSec    Int?
  agentId        String?
  conversationId String?
  metadata       Json          @default("{}")
  createdAt      DateTime      @default(now())
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model Webhook {
  id        String       @id @default(cuid())
  tenantId  String
  url       String
  events    String[]
  secret    String?
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  tenant    Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  logs      WebhookLog[]
}

model WebhookLog {
  id         String   @id @default(cuid())
  webhookId  String
  event      String
  payload    Json
  statusCode Int?
  success    Boolean
  createdAt  DateTime @default(now())
  webhook    Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id         String   @id @default(cuid())
  tenantId   String
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json     @default("{}")
  ipAddress  String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

model ConnectedAccount {
  id                    String              @id @default(cuid())
  tenantId              String
  provider              String
  accountEmail          String
  accountName           String?
  encryptedAccessToken  String
  encryptedRefreshToken String?
  scopes                String[]
  expiresAt             DateTime?
  status                String              @default("active")
  metadata              Json                @default("{}")
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  assignedAgentId       String?
  assignedAgent         Agent?              @relation(fields: [assignedAgentId], references: [id])
  tenant                Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  emailRules            EmailAgentRule[]
  conversations         EmailConversation[]
  processedEmails       ProcessedEmail[]

  @@unique([tenantId, provider, accountEmail])
}

model EmailAgentRule {
  id                  String           @id @default(cuid())
  tenantId            String
  emailType           String
  mode                String           @default("notify_only")
  replyTemplate       String?
  confidenceThreshold Int              @default(80)
  isActive            Boolean          @default(true)
  assignedAgentId     String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  connectedAccountId  String
  assignedAgent       Agent?           @relation(fields: [assignedAgentId], references: [id])
  connectedAccount    ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  tenant              Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, emailType])
}

model ProcessedEmail {
  id                 String             @id @default(cuid())
  tenantId           String
  connectedAccountId String
  gmailMessageId     String
  threadId           String?
  fromEmail          String
  fromName           String?
  subject            String?
  receivedAt         DateTime
  classification     String?
  confidence         Int?
  body               String?            @db.Text
  extractedData      Json               @default("{}")
  action             String?
  status             String             @default("pending")
  draftReplyId       String?
  approvalId         String?
  taskId             String?
  errorMessage       String?
  createdAt          DateTime           @default(now())
  conversationId     String?
  connectedAccount   ConnectedAccount   @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  conversation       EmailConversation? @relation(fields: [conversationId], references: [id])
  tenant             Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([connectedAccountId, gmailMessageId])
}

model EmailConversation {
  id                 String           @id @default(cuid())
  tenantId           String
  connectedAccountId String
  customerEmail      String
  customerName       String?
  subject            String?
  status             String           @default("open")
  lastMessageId      String?
  allMessageIds      String[]         @default([])
  assignedAgentId    String?
  lastReplyAt        DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  connectedAccount   ConnectedAccount @relation(fields: [connectedAccountId], references: [id], onDelete: Cascade)
  tenant             Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages           ProcessedEmail[]

  @@index([tenantId, customerEmail])
  @@index([connectedAccountId, customerEmail])
}

model ActivityTicket {
  id               String        @id @default(cuid())
  ticketNumber     Int           @default(autoincrement())
  tenantId         String
  source           String        @default("INTERNAL")
  conversationId   String?
  title            String
  subject          String?
  description      String?
  notes            String?
  type             String        @default("GENERAL")
  status           TicketStatus  @default(OPEN)
  priority         TaskPriority  @default(MEDIUM)
  contactRef       String?
  contactPhone     String?
  contactEmail     String?
  createdByAgentId String?
  assignedAgentId  String?
  nextAction       String?
  followUpAt       DateTime?
  resolvedAt       DateTime?
  activityLog      Json          @default("[]")
  searchEmbedding  Json?
  metadata         Json          @default("{}")
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  leadId           String?
  assignedAgent    Agent?        @relation("TicketAssignee", fields: [assignedAgentId], references: [id])
  conversation     Conversation? @relation(fields: [conversationId], references: [id])
  createdBy        Agent?        @relation("TicketCreator", fields: [createdByAgentId], references: [id])
  tenant           Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, source])
  @@index([tenantId, assignedAgentId])
  @@index([tenantId, followUpAt])
  @@index([tenantId, leadId])
}

model ConversationSummary {
  id             String        @id @default(cuid())
  tenantId       String
  agentId        String
  conversationId String?
  summaryType    String        @default("CONVERSATION")
  summary        String
  keyEntities    String[]
  embedding      Json?
  messageCount   Int           @default(0)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  subjectKey     String?
  importance     Int           @default(0)
  deletedAt      DateTime?
  agent          Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tenant         Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId, createdAt])
  @@index([tenantId, agentId, subjectKey])
}

model AgentMemoryFact {
  id                   String    @id @default(cuid())
  tenantId             String
  agentId              String
  subjectKey           String
  fact                 String
  category             String    @default("general")
  embedding            Json?
  confidence           Float     @default(0.8)
  sourceConversationId String?
  importance           Int       @default(1)
  deletedAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  agent                Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant               Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId, subjectKey])
  @@index([tenantId, agentId, deletedAt])
}

model MessageChunk {
  id             String   @id @default(cuid())
  tenantId       String
  agentId        String
  conversationId String
  messageId      String
  subjectKey     String?
  role           String
  chunkIndex     Int      @default(0)
  content        String
  embedding      Json?
  createdAt      DateTime @default(now())
  agent          Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, agentId, conversationId])
  @@index([tenantId, agentId, subjectKey])
  @@index([messageId])
}

model StormReport {
  id         String   @id @default(cuid())
  tenantId   String
  reportDate DateTime
  type       String
  time       String?
  state      String
  county     String?
  location   String?
  lat        Float?
  lon        Float?
  size       Float?
  comments   String?
  createdAt  DateTime @default(now())
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, reportDate])
  @@index([tenantId, state])
  @@index([tenantId, type, reportDate])
}

model TenantFeatureFlag {
  id        String    @id @default(cuid())
  tenantId  String
  feature   String
  enabled   Boolean   @default(false)
  enabledAt DateTime?
  enabledBy String?
  notes     String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, feature])
  @@index([tenantId])
}

model SocialAccount {
  id           String              @id @default(cuid())
  tenantId     String
  platform     String
  accountName  String
  pageId       String?
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  tenant       Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  interactions SocialInteraction[]
  posts        SocialPost[]

  @@unique([tenantId, platform])
  @@index([tenantId])
}

model SocialPost {
  id              String         @id @default(cuid())
  tenantId        String
  agentId         String?
  socialAccountId String?
  platform        String
  content         String
  imageUrl        String?
  imagePrompt     String?
  contentType     String         @default("general")
  status          String         @default("draft")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  platformPostId  String?
  errorMessage    String?
  approvalId      String?
  metadata        Json           @default("{}")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  socialAccount   SocialAccount? @relation(fields: [socialAccountId], references: [id])
  tenant          Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([tenantId, platform])
  @@index([scheduledAt])
}

model SocialInteraction {
  id              String        @id @default(cuid())
  tenantId        String
  socialAccountId String
  agentId         String?
  platform        String
  type            String
  externalId      String
  parentId        String?
  senderId        String?
  senderName      String?
  content         String
  replyContent    String?
  status          String        @default("received")
  errorMessage    String?
  createdAt       DateTime      @default(now())
  repliedAt       DateTime?
  socialAccount   SocialAccount @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)
  tenant          Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([platform, externalId])
  @@index([tenantId, createdAt])
  @@index([socialAccountId])
}

model SsoToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  source    String
  used      Boolean  @default(false)
  expiresAt DateTime
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token, source])
  @@index([userId])
}

enum CommChannel {
  SMS
  WHATSAPP
  VOICE
}

enum CommDirection {
  INBOUND
  OUTBOUND
}

enum Industry {
  ROOFING
  CAR_DEALERSHIP
  CLEANING
  SECURITY
