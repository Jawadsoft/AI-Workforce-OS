# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_workforce_os"

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────
DEFAULT_AI_PROVIDER="openai"   # openai | claude | gemini

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-1.5-pro"

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ─────────────────────────────────────────────
# AWS S3
# ─────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_S3_BUCKET="ai-workforce-os"

# ─────────────────────────────────────────────
# APP URLS
# ─────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
PORT=3001

# ─────────────────────────────────────────────
# NEXT.JS PUBLIC VARS (prefix NEXT_PUBLIC_)
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# ─────────────────────────────────────────────
# OPTIONAL: VOICE (Phase 2)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
VAPI_API_KEY=""
RETELL_API_KEY=""
