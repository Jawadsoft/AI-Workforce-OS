# ─────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/ai_workforce_os"

# ─────────────────────────────────────────────
# AUTH
# ─────────────────────────────────────────────
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"
JWT_EXPIRES_IN="7d"

# ─────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────
DEFAULT_AI_PROVIDER="openai"   # openai | claude | gemini

OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4o"

ANTHROPIC_API_KEY="sk-ant-..."
CLAUDE_MODEL="claude-3-5-sonnet-20241022"

GEMINI_API_KEY="..."
GEMINI_MODEL="gemini-1.5-pro"

ELEVENLABS_API_KEY="..."
ELEVENLABS_VOICE_ID="21m00Tcm4TlvDq8ikWAM"

# ─────────────────────────────────────────────
# EMAIL / SMTP
# ─────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM_NAME="AI Workforce OS"
SMTP_FROM_EMAIL=""

# ─────────────────────────────────────────────
# IMAP (local scripts: seed-imap-account, test-imap)
# ─────────────────────────────────────────────
SEED_IMAP_EMAIL=""
SEED_IMAP_PASSWORD=""
SEED_IMAP_NAME=""
SEED_IMAP_HOST="imap.one.com"
SEED_IMAP_PORT=993
SEED_SMTP_HOST="send.one.com"
SEED_SMTP_PORT=587

# ─────────────────────────────────────────────
# REDIS
# ─────────────────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ─────────────────────────────────────────────
# AWS S3
# ─────────────────────────────────────────────
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="..."
AWS_SECRET_ACCESS_KEY="..."
AWS_S3_BUCKET="ai-workforce-os"

# ─────────────────────────────────────────────
# CLOUDINARY (avatar / image storage)
# ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ─────────────────────────────────────────────
# APP URLS
# ─────────────────────────────────────────────
FRONTEND_URL="http://localhost:3000"
PORT=3001

# ─────────────────────────────────────────────
# NEXT.JS PUBLIC VARS (prefix NEXT_PUBLIC_)
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL="http://localhost:3001/api/v1"
NEXT_PUBLIC_WS_URL="http://localhost:3001"

# ─────────────────────────────────────────────
# OPTIONAL: VOICE (Phase 2)
# ─────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
VAPI_API_KEY=""
RETELL_API_KEY=""

# ─────────────────────────────────────────────
# IMAGE GENERATION
# ─────────────────────────────────────────────
DALLE_ENABLED=true
UNSPLASH_ACCESS_KEY=""

# ─────────────────────────────────────────────
# SOCIAL MEDIA OAUTH
# Facebook + Instagram: developers.facebook.com → Create App (Business)
#   Add: Facebook Login + Instagram Basic Display
#   Redirect URI: https://YOUR_API_DOMAIN/api/v1/social/oauth/facebook/callback
# LinkedIn: linkedin.com/developers → Create App
#   Add: Sign In with LinkedIn + Share on LinkedIn
#   Redirect URI: https://YOUR_API_DOMAIN/api/v1/social/oauth/linkedin/callback
# X (Twitter): developer.twitter.com → Create Project + App, enable OAuth 2.0
#   Redirect URI: https://YOUR_API_DOMAIN/api/v1/social/oauth/x/callback
# ─────────────────────────────────────────────
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
LINKEDIN_CLIENT_ID=""
LINKEDIN_CLIENT_SECRET=""
X_CLIENT_ID=""
X_CLIENT_SECRET=""
# Base URL for OAuth redirects (your API domain, no trailing slash)
SOCIAL_OAUTH_REDIRECT_BASE="https://your-api-domain.onrender.com/api/v1"
